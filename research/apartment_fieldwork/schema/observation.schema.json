{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jaesung0804/turbo-potato/research/apartment_fieldwork/schema/observation.schema.json",
  "title": "Apartment fieldwork claim v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "entity",
    "feature",
    "value",
    "unit",
    "kind",
    "confidence",
    "scope",
    "sources",
    "observed_at",
    "collected_at",
    "limitations",
    "model_eligible"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "official_id",
        "address",
        "identity_status"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "official_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "identity_status": {
          "enum": [
            "unresolved",
            "address_candidate",
            "officially_linked"
          ]
        }
      }
    },
    "feature": {
      "type": "string",
      "minLength": 1
    },
    "value": {},
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "enum": [
        "official_record",
        "direct_measurement",
        "platform_display",
        "reported_transaction",
        "reported_market_context",
        "resident_review",
        "advertisement",
        "derived_secondary",
        "calculated_comparison",
        "unverified"
      ]
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grade",
        "rationale"
      ],
      "properties": {
        "grade": {
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "building",
        "line",
        "floor",
        "orientation",
        "exclusive_area_m2",
        "area_label"
      ],
      "properties": {
        "level": {
          "enum": [
            "complex",
            "building",
            "line",
            "unit",
            "route",
            "district",
            "unknown"
          ]
        },
        "building": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": [
            "string",
            "null"
          ]
        },
        "floor": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "orientation": {
          "type": [
            "string",
            "null"
          ]
        },
        "exclusive_area_m2": {
          "type": [
            "number",
            "null"
          ]
        },
        "area_label": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "publisher",
          "published_at",
          "access_status"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "publisher": {
            "type": "string"
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "access_status": {
            "enum": [
              "original_page_opened",
              "search_excerpt_only",
              "not_accessed"
            ]
          },
          "upstream_source": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "observed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "collected_at": {
      "type": "string"
    },
    "price_type": {
      "enum": [
        "asking",
        "transaction",
        "reported_market_price",
        "KB_estimate",
        null
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "model_eligible": {
      "const": false
    }
  }
}
