# Render only @@PUBLIC_IP@@. Leave Nginx $variables unchanged.
# Install this HTTPS server only after a trusted IP certificate is verified.
server {
    listen 80 default_server;
    server_name @@PUBLIC_IP@@;
    access_log off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    # Plain HTTP never proxies API traffic, including bearer tokens.
    location / { return 404; }
}

server {
    listen 443 ssl default_server;
    server_name @@PUBLIC_IP@@;
    server_tokens off;
    access_log off;
    error_log /var/log/nginx/research-backend-error.log warn;

    ssl_certificate /etc/letsencrypt/live/research-backend-ip/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/research-backend-ip/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:research_backend_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 2g;
    client_body_timeout 300s;
    send_timeout 300s;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 15s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_redirect off;
    }
}
