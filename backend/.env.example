# Development: SQLite on local disk. Production: oracle (one DB/user per project).
BACKEND_DATABASE=sqlite
BACKEND_DATA_DIR=runtime
ESTATE_API_TOKEN=replace-with-32-or-more-random-characters
INVESTMENT_API_TOKEN=replace-with-a-different-random-token
# Never embed these bearer tokens in a public website.

# BACKEND_DATABASE=oracle
# ESTATE_ORACLE_USER=ESTATE_APP
# ESTATE_ORACLE_PASSWORD=
# ESTATE_ORACLE_DSN=estate_low
# ESTATE_ORACLE_WALLET_DIR=/run/secrets/estate-wallet
# ESTATE_ORACLE_WALLET_PASSWORD=
# INVESTMENT_ORACLE_USER=INVESTMENT_APP
# INVESTMENT_ORACLE_PASSWORD=
# INVESTMENT_ORACLE_DSN=investment_low
# INVESTMENT_ORACLE_WALLET_DIR=/run/secrets/investment-wallet
# INVESTMENT_ORACLE_WALLET_PASSWORD=
ORACLE_POOL_SIZE=3

# local for development; oci for a private OCI Object Storage bucket.
BACKEND_BLOB_STORE=local
# OCI_CONFIG_FILE=/run/secrets/oci-config
# OCI_PROFILE=DEFAULT
# OCI_AUTH=api_key
# Temporary CLI login can use OCI_AUTH=security_token. Restart after token refresh.
# OCI_NAMESPACE=
# OCI_BUCKET=
# OCI_USE_INSTANCE_PRINCIPAL=false
# Bound individual uploads; retain photos/raw data outside Git and database rows.
MAX_UPLOAD_BYTES=2147483648
# Requests return at most 200 rows / 256 KiB by default.
MAX_RESPONSE_BYTES=262144
